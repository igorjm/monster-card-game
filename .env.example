# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave publicável (frontend, apenas Realtime)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta (service role) — SOMENTE no servidor, nunca exponha!
# Dashboard > Project Settings > API Keys
SUPABASE_SECRET_KEY=

# LiveKit Cloud — voz na discussão (https://cloud.livekit.io)
# URL tipo wss://seu-projeto.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Marca padrão da home/PWA e tema inicial das novas salas.
# Valores internos atuais: vila-criaturas, folclore-br, rio-satira
NEXT_PUBLIC_DEFAULT_THEME_ID=vila-criaturas
# Em produção, prévias ficam ocultas e não podem ser escolhidas sem esta flag.
NEXT_PUBLIC_ENABLE_PREVIEW_THEMES=0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comércio PWA. Continue em 0 até todos os itens de docs/legal/RELEASE_GATES.md.
COMMERCIAL_RELEASE_ENABLED=0
# Somente para refletir o estado na interface; o servidor continua autoritativo.
NEXT_PUBLIC_COMMERCIAL_RELEASE_ENABLED=0
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# O valor inteiro do header Authorization configurado no webhook RevenueCat.
REVENUECAT_WEBHOOK_AUTHORIZATION=
