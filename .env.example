# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave publicável (frontend, apenas Realtime)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta (service role) — SOMENTE no servidor, nunca exponha!
# Dashboard > Project Settings > API Keys
SUPABASE_SECRET_KEY=

# LiveKit Cloud — voz na discussão (https://cloud.livekit.io)
# URL tipo wss://seu-projeto.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Marca padrão da home/PWA e tema inicial das novas salas.
# Valores atuais: monstros, folclore-br, rio-satira
NEXT_PUBLIC_DEFAULT_THEME_ID=monstros
# Em produção, prévias ficam ocultas e não podem ser escolhidas sem esta flag.
NEXT_PUBLIC_ENABLE_PREVIEW_THEMES=0
NEXT_PUBLIC_APP_URL=https://lobisomem-monstros.vercel.app
